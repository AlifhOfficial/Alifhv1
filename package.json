{
  "name": "revvup",
  "version": "0.1.0",
  "private": true,
  "description": "Revvup - Vehicle Marketplace & Valuation Platform",
  "packageManager": "bun@1.2.5",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:ws": "cd apps/ws && bun run src/index.ts",
    "build": "turbo run build --filter='!@alifh/mobile'",
    "build:all": "turbo run build",
    "build:web": "turbo run build --filter=@alifh/web",
    "build:mobile": "turbo run build --filter=@alifh/mobile",
    "start": "cd apps/web && bun run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "db:seed:all": "cd apps/web && bun ../../scripts/seed-all.ts",
    "db:seed:100": "cd apps/web && bun ../../scripts/seed-100-listings.ts",
    "db:seed:listings": "cd apps/web && bun ../../scripts/seed-listings-v2.ts",
    "partners:setup": "cd apps/web && bun ../../scripts/setup-partners-and-staff.ts",
    "r2:migrate": "cd apps/web && bun scripts/migrate-public-to-r2.ts",
    "r2:migrate:dry": "cd apps/web && bun scripts/migrate-public-to-r2.ts --dry-run",
    "r2:watch": "cd apps/web && bun scripts/r2-watch.ts"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/ws",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "20.19.27",
    "@types/pg": "8.16.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.2.3",
    "babel-preset-expo": "~14.0.0",
    "eslint": "9.28.0",
    "pg": "8.16.3",
    "prettier": "3.5.3",
    "turbo": "2.8.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.2.3",
    "drizzle-orm": "0.45.1"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "cheerio": "1.2.0"
  }
}
