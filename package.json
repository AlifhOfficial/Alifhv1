{
  "name": "alifh",
  "version": "0.1.0",
  "private": true,
  "description": "Alifh - Vehicle Marketplace & Valuation Platform",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:ws": "cd apps/ws && bun run src/index.ts",
    "dev:warmup": "bun scripts/warmup-dev.ts",
    "build": "turbo run build --filter='!@alifh/mobile'",
    "build:all": "turbo run build",
    "build:web": "turbo run build --filter=@alifh/web",
    "build:mobile": "turbo run build --filter=@alifh/mobile",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "db:seed": "bun scripts/seed.ts",
    "db:seed:all": "cd apps/web && bun ../../scripts/seed-all.ts",
    "db:reset": "bun scripts/reset-db.ts",
    "users:seed": "cd apps/web && bun ../../scripts/create-test-users.ts",
    "users:clear": "cd apps/web && bun ../../scripts/clear-users.ts",
    "partners:setup": "cd apps/web && bun ../../scripts/setup-partners-and-staff.ts",
    "sessions:clear": "cd apps/web && bun ../../scripts/clear-sessions.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "20.19.27",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.28.0",
    "pg": "8.16.3",
    "prettier": "3.5.3",
    "turbo": "2.7.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-orm": "0.45.1"
  },
  "dependencies": {
    "@cardog/corgi": "1.3.0"
  }
}
