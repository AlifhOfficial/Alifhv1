FROM oven/bun:1.2-slim

WORKDIR /app

# Copy only the preprocessing app — self-contained, no shared packages needed
COPY package.preprocessing.json ./package.json
COPY bun.lock ./
COPY apps/preprocessing/package.json ./apps/preprocessing/
COPY apps/preprocessing/src ./apps/preprocessing/src/
COPY apps/preprocessing/tsconfig.json ./apps/preprocessing/

# Install dependencies (sharp pulls pre-built native binary for linux/amd64)
RUN bun install

# Build single-file bundle for fast startup
RUN cd apps/preprocessing && bun run build

WORKDIR /app/apps/preprocessing

EXPOSE 3002

CMD ["bun", "run", "dist/index.js"]
