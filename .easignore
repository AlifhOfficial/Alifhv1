# EAS Build Ignore - Mobile-only build scope
# Keep only mobile + shared packages in the upload to reduce build size.

# Exclude documentation and assets
docs/
logo/

# Exclude non-mobile apps
apps/web/
apps/ws/
apps/preprocessing/

# Exclude non-mobile packages
packages/ai/
packages/database/

# Root config files not needed for mobile (keep package.json for monorepo)
turbo.json
vercel.json
check-slugs.ts
test-sitemap.ts
auto-ae-brands-full.json
auto-ae-brands-simplified.json

# Git
.git/

# Node modules (EAS installs fresh)
node_modules/
**/node_modules/

# Development files
**/.expo/
*.log

# Build outputs
**/dist/
**/build/
**/.next/
**/.turbo/

# Native build folders (rebuilt by EAS)
apps/mobile/android/
apps/mobile/ios/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
