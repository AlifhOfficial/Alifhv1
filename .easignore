# EAS Build Ignore - Mobile-only build scope
# Keep only mobile + shared packages in the upload to reduce build size.

# Exclude documentation and assets
docs/
logo/

# Exclude non-mobile app contents but keep workspace manifests for Bun
apps/web/*
!apps/web/package.json

apps/ws/*
!apps/ws/package.json

apps/preprocessing/*
!apps/preprocessing/package.json
!apps/preprocessing/package.preprocessing.json

# Exclude non-mobile package contents but keep workspace manifests for Bun
packages/ai/*
!packages/ai/package.json

packages/database/*
!packages/database/package.json
!packages/database/src/
!packages/database/src/**

# Root config files not needed for mobile (keep package.json for monorepo)
turbo.json
vercel.json
check-slugs.ts
test-sitemap.ts
auto-ae-brands-full.json
auto-ae-brands-simplified.json

# Git
.git/

# Node modules (EAS installs fresh)
node_modules/
**/node_modules/

# Development files
**/.expo/
*.log

# Build outputs
**/dist/
**/build/
**/.next/
**/.turbo/

# Native build folders (rebuilt by EAS)
apps/mobile/android/
apps/mobile/ios/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
