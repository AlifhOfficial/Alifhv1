{
  "name": "@alifh/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle ORM auth database schema and queries",
  "packageManager": "bun@1.3.4",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    },
    "./listing-constants": {
      "import": "./src/schema/listing-constants.ts",
      "types": "./src/schema/listing-constants.ts"
    }
  },
  "scripts": {
    "build": "echo 'using source files directly'",
    "generate": "bun x drizzle-kit generate",
    "migrate": "bun ./src/migrate.ts",
    "db:push": "bun x drizzle-kit push",
    "studio": "bun x drizzle-kit studio",
    "lint": "bun x eslint src/**/*.ts",
    "format": "bun x prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@paralleldrive/cuid2": "3.0.4",
    "drizzle-orm": "0.45.1",
    "pg": "8.16.0"
  },
  "devDependencies": {
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.8"
  }
}
