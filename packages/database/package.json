{
  "name": "@alifh/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle ORM auth database schema and queries",
  "packageManager": "bun@1.3.4",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "echo 'using source files directly'",
    "generate": "drizzle-kit generate",
    "migrate": "bun ./src/migrate.ts",
    "db:push": "drizzle-kit push",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@paralleldrive/cuid2": "^3.0.4",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "0.31.8",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3"
  }
}
