{
  "name": "@alifh/ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI helpers for valuation and moderation",
  "packageManager": "bun@1.3.4",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./valuation": {
      "import": "./src/valuation/index.ts",
      "types": "./src/valuation/index.ts"
    },
    "./moderation": {
      "import": "./src/moderation/index.ts",
      "types": "./src/moderation/index.ts"
    },
    "./description": {
      "import": "./src/description/index.ts",
      "types": "./src/description/index.ts"
    },
    "./fuel": {
      "import": "./src/fuel/index.ts",
      "types": "./src/fuel/index.ts"
    },
    "./search": {
      "import": "./src/search/index.ts",
      "types": "./src/search/index.ts"
    },
    "./summary": {
      "import": "./src/summary/index.ts",
      "types": "./src/summary/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'using source files directly'",
    "lint": "bun x eslint src/**/*.ts",
    "format": "bun x prettier --write src/**/*.ts"
  },
  "dependencies": {
    "openai": "6.15.0"
  },
  "devDependencies": {}
}
