{
  "name": "@alifh/ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI helpers for valuation and moderation",
  "packageManager": "bun@1.3.4",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./valuation": {
      "import": "./src/valuation/index.ts",
      "types": "./src/valuation/index.ts"
    },
    "./moderation": {
      "import": "./src/moderation/index.ts",
      "types": "./src/moderation/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'using source files directly'",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "openai": "6.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3"
  }
}
