{
  "name": "@alifh/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:ios": "expo start --dev-client --ios",
    "start:android": "expo start --dev-client --android",
    "run:ios": "expo run:ios",
    "run:android": "expo run:android",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:dev:ios": "eas build --profile development --platform ios --local",
    "build:dev:android": "eas build --profile development --platform android --local",
    "build:dev:ios:cloud": "eas build --profile development --platform ios",
    "build:dev:android:cloud": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "update:preview": "eas update --branch preview --message",
    "update:prod": "eas update --branch production --message",
    "lint": "expo lint --max-warnings=0 && echo \"mobile lint: clean (0 warnings)\""
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "5.90.21",
    "date-fns": "4.1.0",
    "expo": "~55.0.9",
    "expo-apple-authentication": "~55.0.11",
    "expo-asset": "~55.0.12",
    "expo-audio": "~55.0.11",
    "expo-auth-session": "~55.0.12",
    "expo-blur": "~55.0.12",
    "expo-calendar": "~55.0.12",
    "expo-clipboard": "~55.0.11",
    "expo-constants": "~55.0.11",
    "expo-dev-client": "~55.0.22",
    "expo-device": "~55.0.12",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.11",
    "expo-image": "~55.0.8",
    "expo-image-manipulator": "~55.0.13",
    "expo-image-picker": "~55.0.16",
    "expo-linear-gradient": "~55.0.11",
    "expo-location": "~55.1.6",
    "expo-navigation-bar": "~55.0.10",
    "expo-notifications": "~55.0.16",
    "expo-router": "~55.0.10",
    "expo-splash-screen": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.13",
    "expo-updates": "~55.0.18",
    "expo-web-browser": "~55.0.12",
    "lucide-react-native": "0.563.0",
    "moti": "0.30.0",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-passkey": "3.3.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "private": true,
  "description": "Revvup is Dubai's fee-free car marketplace. No listing fees, no paid boosts, no ads. Quality ranks. Book test drives online. Get the Revvup mobile app."
}
