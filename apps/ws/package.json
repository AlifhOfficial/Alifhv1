{
  "name": "@alifh/ws",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket server for real-time updates",
  "packageManager": "bun@1.2.5",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env.local src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist",
    "start": "bun --env-file=../../.env.local dist/index.js",
    "lint": "bun x eslint src/**/*.ts",
    "format": "bun x prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@alifh/database": "workspace:*",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/ws": "8.5.10",
    "bun-types": "1.3.9"
  }
}
