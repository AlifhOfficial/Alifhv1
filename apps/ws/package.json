{
  "name": "@alifh/ws",
  "version": "0.1.0",
  "private": true,
  "description": "Revvup is Dubai's fee-free car marketplace. No listing fees, no paid boosts, no ads. Quality ranks. Book test drives online. Get the Revvup mobile app.",
  "packageManager": "bun@1.2.5",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env.local src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --packages external",
    "start": "bun --env-file=../../.env.local dist/index.js",
    "lint": "bun x eslint src/**/*.ts",
    "format": "bun x prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@alifh/database": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "1.3.9"
  }
}
