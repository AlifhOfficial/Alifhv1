{
  "regions": ["dxb1"],
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "crons": [
    {
      "path": "/api/cron/expire-listings",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-google-reviews",
      "schedule": "0 0 1,16 * *"
    },
    {
      "path": "/api/internal/warm-cache",
      "schedule": "*/10 * * * *"
    }
  ]
}
