{
  "installCommand": "cd ../.. && bun install --filter='@alifh/web' --filter='@alifh/database' --filter='@alifh/ai' --filter='@alifh/shared' --frozen-lockfile",
  "buildCommand": "bun run build",
  "crons": [
    {
      "path": "/api/cron/expire-listings",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-google-reviews",
      "schedule": "0 3 * * *"
    }
  ]
}
