{
  "installCommand": "cd apps/web && bun install",
  "buildCommand": "cd apps/web && bun run build",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "status.revvup.ae" }],
      "destination": "/status"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "status.revvup.ae" }],
      "destination": "/status"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-listings",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-google-reviews",
      "schedule": "0 3 * * *"
    }
  ]
}
